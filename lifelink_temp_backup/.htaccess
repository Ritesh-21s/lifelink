# Apache configuration for LifeLink

# Disable directory listing
Options -Indexes

# Custom error pages
ErrorDocument 404 /lifelink/404.php
ErrorDocument 403 /lifelink/pages/403.php

# Protect sensitive directories
<FilesMatch "\.(sql|log|md|json)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Allow .json only from api/ folder (handled by PHP, not static)
<Directory "api">
    Order allow,deny
    Allow from all
</Directory>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Cache static assets
<FilesMatch "\.(css|js|png|jpg|gif|svg|woff2)$">
    Header set Cache-Control "max-age=86400, public"
</FilesMatch>
